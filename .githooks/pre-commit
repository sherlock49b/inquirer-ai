#!/usr/bin/env bash
# Language gates run SEQUENTIALLY, not in parallel. Running all four suites
# (each an internally-parallel test runner) at once oversubscribes the CPU and
# makes the socket integration tests' subprocess-spawn timeouts flaky on
# commits that touch several languages (or spec/.githooks/.github, which run
# all four). Sequential is a little slower for those rare multi-language
# commits but reliable. Single-language commits — the common case — run exactly
# one gate, so this costs nothing there.

ROOT="$(git rev-parse --show-toplevel)"

# Ensure tests run in human/default mode, not agent mode
# (cz commit sets INQUIRER_AI_MODE=agent which breaks socket tests)
unset INQUIRER_AI_MODE INQUIRER_AI_TRANSPORT INQUIRER_AI_FD_IN INQUIRER_AI_FD_OUT

# Detect which languages have staged changes
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
RUN_PY=false; RUN_GO=false; RUN_TS=false; RUN_RS=false

for f in $CHANGED_FILES; do
  case "$f" in
    python/*) RUN_PY=true ;;
    go/*)     RUN_GO=true ;;
    typescript/*) RUN_TS=true ;;
    rust/*)   RUN_RS=true ;;
    spec/*|.githooks/*|.github/*) RUN_PY=true; RUN_GO=true; RUN_TS=true; RUN_RS=true ;;
  esac
done

if ! $RUN_PY && ! $RUN_GO && ! $RUN_TS && ! $RUN_RS; then
  echo "pre-commit: no language files changed, skipping checks"
  exit 0
fi

FAILED=()

# Run a check, streaming its output. On failure, record it and keep going so
# the developer sees every failing language in one run rather than one at a time.
run_check() {
  local name="$1"
  shift
  echo "pre-commit: [$name] running..."
  if "$@"; then
    echo "pre-commit: [$name] OK"
  else
    echo "pre-commit: [$name] FAILED"
    FAILED+=("$name")
  fi
}

if $RUN_PY; then
  run_check "python" bash -c "
    cd '$ROOT/python'
    echo '=== ruff check ===' && uv run ruff check src/ tests/ &&
    echo '=== ruff format ===' && uv run ruff format --check src/ tests/ &&
    echo '=== pyright ===' && uv run pyright src/ &&
    echo '=== pytest ===' && uv run pytest tests/ -q
  "
fi

if $RUN_GO; then
  run_check "go" bash -c "
    cd '$ROOT/go'
    UNFORMATTED=\$(gofmt -l ./prompt/ ./examples/)
    if [ -n \"\$UNFORMATTED\" ]; then
      echo \"Files need gofmt: \$UNFORMATTED\"; exit 1
    fi
    echo '=== vet ===' && go vet ./prompt/ ./examples/... &&
    echo '=== test ===' && go test ./prompt/ -count=1 -short
  "
fi

if $RUN_TS; then
  run_check "typescript" bash -c "
    cd '$ROOT/typescript'
    echo '=== tsc ===' && npx tsc --noEmit &&
    echo '=== biome ===' && npx biome check src/ tests/ &&
    echo '=== vitest ===' && npx vitest run
  "
fi

if $RUN_RS; then
  run_check "rust" bash -c "
    cd '$ROOT/rust'
    echo '=== fmt ===' && cargo fmt -- --check &&
    echo '=== clippy ===' && cargo clippy -- -D warnings &&
    echo '=== test ===' && cargo test --quiet
  "
fi

if [ ${#FAILED[@]} -ne 0 ]; then
  echo "pre-commit: FAILED: ${FAILED[*]}"
  exit 1
fi

echo "pre-commit: all checks passed"
exit 0
